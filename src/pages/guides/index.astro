---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCardList from '../../components/ArticleCardList.astro';
import ClientSetupEntry from '../../components/ClientSetupEntry.astro';
import { siteConfig } from '../../data/site';

const pageTitle = '闪电猫 SpeedCAT 使用教程与配置指南专栏｜闪电猫 SpeedCAT';
const pageDescription = '查阅闪电猫 SpeedCAT 全套 6 篇原创帮助教程，涵盖新手入门、Windows、Android、iPhone 客户端使用、流量查看与连接故障排查。';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: 'https://iflashcat.lol/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '使用教程',
      item: 'https://iflashcat.lol/guides/'
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/guides/"
  jsonLd={breadcrumbSchema}
>
  <div class="page-header-banner">
    <div class="container">
      <nav class="breadcrumb" aria-label="路径导航">
        <a href="/">首页</a>
        <span class="breadcrumb-separator">/</span>
        <span class="current-crumb">使用教程</span>
      </nav>
      <h1 class="page-title">闪电猫 SpeedCAT 知识与配置专栏</h1>
      <p class="page-subtitle">
        专为闪电猫用户打造的 6 篇系统化帮助图文指南，涵盖新手入门、多端客户端配置、流量查看与连接排查。
      </p>
    </div>
  </div>

  <!-- Articles List (6 original articles) -->
  <ArticleCardList showTitle={false} />

  <!-- Client Setup Entry Points -->
  <ClientSetupEntry />
</BaseLayout>

<style>
  .page-header-banner {
    background: linear-gradient(135deg, #0B0F19 0%, #1C2541 100%);
    color: #FFFFFF;
    padding: 60px 0 50px;
    border-bottom: 1px solid rgba(250, 204, 21, 0.2);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: #94A3B8;
    margin-bottom: 20px;
  }

  .breadcrumb a {
    color: #CBD5E1;
  }

  .breadcrumb a:hover {
    color: #FACC15;
  }

  .current-crumb {
    color: #FACC15;
    font-weight: 600;
  }

  .page-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 14px;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: #CBD5E1;
    max-width: 780px;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 1.8rem;
    }
    .page-subtitle {
      font-size: 0.95rem;
    }
  }
</style>
