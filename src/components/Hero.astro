---
import { siteConfig } from '../data/site';
---

<section class="hero-section">
  <div class="aurora-bg">
    <div class="aurora-glow glow-1"></div>
    <div class="aurora-glow glow-2"></div>
    <div class="aurora-grid-lines"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>闪电猫 SpeedCAT · 套餐与使用指南</span>
      </div>

      <h1 class="hero-title">
        闪电猫 SpeedCAT｜套餐信息与订阅使用指南
      </h1>

      <p class="hero-subtitle">
        快速了解闪电猫的套餐特点、流量规则、设备兼容与常见使用说明，帮助你更轻松地完成订阅选择、客户端配置与日常使用。
      </p>

      <div class="hero-actions">
        <a href="/pricing/" class="btn btn-primary hero-btn">
          查看完整套餐
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a 
          href={siteConfig.affUrl} 
          target={siteConfig.affTarget} 
          rel={siteConfig.affRel} 
          class="btn btn-cyan hero-btn"
        >
          {siteConfig.affButtonText}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7"/>
            <path d="M7 7h10v10"/>
          </svg>
        </a>
      </div>

      <div class="hero-meta-notice">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#06B6D4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>注：外部按钮为指定推广入口，与 SpeedCAT 实际销售对应关系待核实，请以最终结算页为准。</span>
      </div>
    </div>

    <!-- Right: Deep Sea Tech Lightning Illustration -->
    <div class="hero-visual">
      <div class="tech-graphic-card">
        <svg class="hero-svg-art" viewBox="0 0 480 400" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Background Grid & Orbital Rings -->
          <circle cx="240" cy="200" r="160" stroke="#008B83" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.4"/>
          <circle cx="240" cy="200" r="120" stroke="#06B6D4" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.5"/>
          <circle cx="240" cy="200" r="80" stroke="#0284C7" stroke-width="2" opacity="0.6"/>

          <!-- Tech Network Nodes -->
          <g class="network-nodes" opacity="0.85">
            <circle cx="120" cy="120" r="6" fill="#06B6D4"/>
            <line x1="120" y1="120" x2="200" y2="160" stroke="#06B6D4" stroke-width="1.5" stroke-dasharray="2 4"/>
            <circle cx="360" cy="130" r="6" fill="#008B83"/>
            <line x1="360" y1="130" x2="280" y2="170" stroke="#008B83" stroke-width="1.5" stroke-dasharray="2 4"/>
            <circle cx="100" cy="270" r="5" fill="#0284C7"/>
            <line x1="100" y1="270" x2="180" y2="240" stroke="#0284C7" stroke-width="1.5" stroke-dasharray="2 4"/>
            <circle cx="370" cy="280" r="5" fill="#06B6D4"/>
            <line x1="370" y1="280" x2="290" y2="240" stroke="#06B6D4" stroke-width="1.5" stroke-dasharray="2 4"/>
          </g>

          <!-- Glowing Central Core with Cyber Cat Head -->
          <defs>
            <radialGradient id="coreGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.35"/>
              <stop offset="70%" stop-color="#008B83" stop-opacity="0.15"/>
              <stop offset="100%" stop-color="#061C2C" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="catGradient" x1="180" y1="120" x2="300" y2="280" gradientUnits="userSpaceOnUse">
              <stop stop-color="#06B6D4"/>
              <stop offset="50%" stop-color="#008B83"/>
              <stop offset="100%" stop-color="#0284C7"/>
            </linearGradient>
            <linearGradient id="boltGrad" x1="220" y1="80" x2="260" y2="310" gradientUnits="userSpaceOnUse">
              <stop stop-color="#38BDF8"/>
              <stop offset="60%" stop-color="#06B6D4"/>
              <stop offset="100%" stop-color="#FFFFFF"/>
            </linearGradient>
          </defs>

          <!-- Core aura -->
          <circle cx="240" cy="200" r="100" fill="url(#coreGlow)"/>

          <!-- Abstract Cyber Cat Silhouette -->
          <!-- Ears -->
          <path d="M170 140L195 205H285L310 140L260 170H220L170 140Z" fill="url(#catGradient)" opacity="0.9"/>
          <!-- Cat Eyes (Electric Cyan glow) -->
          <ellipse cx="210" cy="190" rx="9" ry="5" fill="#06B6D4"/>
          <ellipse cx="270" cy="190" rx="9" ry="5" fill="#06B6D4"/>
          <circle cx="210" cy="190" r="2.5" fill="#FFFFFF"/>
          <circle cx="270" cy="190" r="2.5" fill="#FFFFFF"/>

          <!-- Whiskers as data lines -->
          <path d="M160 200L120 195" stroke="#06B6D4" stroke-width="2" stroke-linecap="round"/>
          <path d="M160 212L115 215" stroke="#06B6D4" stroke-width="2" stroke-linecap="round"/>
          <path d="M320 200L360 195" stroke="#06B6D4" stroke-width="2" stroke-linecap="round"/>
          <path d="M320 212L365 215" stroke="#06B6D4" stroke-width="2" stroke-linecap="round"/>

          <!-- Central Speed Lightning Bolt -->
          <path d="M255 90L195 210H250L225 310L305 180H245L255 90Z" fill="url(#boltGrad)" filter="drop-shadow(0 0 14px rgba(6, 182, 212, 0.85))"/>

          <!-- Dynamic Data Flow Particles -->
          <circle cx="220" cy="150" r="2" fill="#FFFFFF"/>
          <circle cx="260" cy="250" r="3" fill="#06B6D4"/>
          <circle cx="290" cy="170" r="2" fill="#38BDF8"/>
        </svg>

        <!-- Floating Metric badges -->
        <div class="metric-tag tag-top">
          <span class="metric-icon">⚡</span>
          <span class="metric-label">7 种公开参考套餐</span>
        </div>
        <div class="metric-tag tag-bottom-left">
          <span class="metric-icon">🌐</span>
          <span class="metric-label">多设备与客户端支持</span>
        </div>
        <div class="metric-tag tag-bottom-right">
          <span class="metric-icon">🛡️</span>
          <span class="metric-label">规则模式智能分流</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background:
      radial-gradient(
        circle at 8% 80%,
        rgba(6, 182, 212, 0.35),
        transparent 38%
      ),
      radial-gradient(
        circle at 92% 12%,
        rgba(0, 139, 131, 0.38),
        transparent 42%
      ),
      linear-gradient(
        120deg,
        #061c2c 0%,
        #082f49 48%,
        #062e35 100%
      );
    color: #F8FAFC;
    padding: 90px 0 100px;
    overflow: hidden;
  }

  .aurora-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .aurora-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
  }

  .glow-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.4) 0%, transparent 70%);
    top: -100px;
    right: 10%;
  }

  .glow-2 {
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(0, 139, 131, 0.4) 0%, transparent 70%);
    bottom: -100px;
    left: 5%;
    opacity: 0.35;
  }

  .aurora-grid-lines {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(6, 182, 212, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(6, 182, 212, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 50px;
  }

  .hero-content {
    max-width: 650px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(0, 139, 131, 0.18);
    border: 1px solid rgba(6, 182, 212, 0.45);
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #E0F2FE;
    margin-bottom: 24px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #06B6D4;
    box-shadow: 0 0 10px #06B6D4;
  }

  .hero-title {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1.25;
    color: #F8FAFC;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    color: #CBD5E1;
    margin-bottom: 34px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }

  .hero-btn {
    padding: 14px 28px;
    font-size: 1rem;
  }

  .hero-meta-notice {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.82rem;
    color: #94A3B8;
    line-height: 1.5;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .tech-graphic-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 1.15;
    background: rgba(8, 47, 73, 0.65);
    border: 1px solid rgba(6, 182, 212, 0.25);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(12px);
    box-shadow: 0 20px 40px rgba(6, 28, 44, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .hero-svg-art {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 10px 20px rgba(6, 28, 44, 0.5));
  }

  .metric-tag {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(6, 28, 44, 0.88);
    border: 1px solid rgba(6, 182, 212, 0.35);
    border-radius: var(--radius-md);
    font-size: 0.8rem;
    font-weight: 600;
    color: #F8FAFC;
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 16px rgba(6, 28, 44, 0.4);
    white-space: nowrap;
  }

  .tag-top {
    top: 15px;
    left: 20px;
    border-color: rgba(0, 139, 131, 0.5);
  }

  .tag-bottom-left {
    bottom: 20px;
    left: 10px;
  }

  .tag-bottom-right {
    bottom: 30px;
    right: 10px;
  }

  @media (max-width: 1024px) {
    .hero-title {
      font-size: 2.2rem;
    }
  }

  @media (max-width: 860px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: left;
      gap: 40px;
    }
    .hero-content {
      max-width: 100%;
    }
    .hero-visual {
      max-width: 400px;
      margin: 0 auto;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      padding: 60px 0 70px;
    }
    .hero-title {
      font-size: 1.8rem;
    }
    .hero-subtitle {
      font-size: 1rem;
    }
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions .btn {
      width: 100%;
    }
    .metric-tag {
      font-size: 0.72rem;
      padding: 4px 8px;
    }
  }
</style>
