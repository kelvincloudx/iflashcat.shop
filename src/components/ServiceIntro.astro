---
import { siteConfig } from '../data/site';
---

<section class="section section-alt section-service-intro">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">品牌服务与架构背景</span>
      <h2>闪电猫 SpeedCAT 服务资料介绍</h2>
      <p>
        全面了解闪电猫的网络定位、技术特征与参考规格，客观呈现公开资料与使用建议。
      </p>
    </div>

    <div class="intro-grid">
      <div class="intro-card">
        <div class="intro-icon icon-purple">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
            <rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
            <line x1="6" y1="6" x2="6.01" y2="6"/>
            <line x1="6" y1="18" x2="6.01" y2="18"/>
          </svg>
        </div>
        <h3 class="intro-card-title">专线中继架构（公开记录）</h3>
        <p class="intro-card-desc">
          公开资料记载闪电猫主要采用多地入口中继及专线加速网络，旨在降低晚高峰网络拥塞和跨境抖动，提升网页加载与流媒体回放的稳定性。
        </p>
        <span class="intro-card-tag">资料核验状态：第三方记录参考</span>
      </div>

      <div class="intro-card">
        <div class="intro-icon icon-cyan">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </div>
        <h3 class="intro-card-title">全球核心节点覆盖</h3>
        <p class="intro-card-desc">
          网络资料显示节点主要分布于香港、日本、新加坡、美国及欧洲核心网络枢纽，支持根据用户当前网络环境与业务目标选择就近接入。
        </p>
        <span class="intro-card-tag">资料核验状态：以客户端拉取为准</span>
      </div>

      <div class="intro-card">
        <div class="intro-icon icon-blue">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="4" width="16" height="16" rx="2" ry="2"/>
            <rect x="9" y="9" width="6" height="6"/>
            <line x1="9" y1="1" x2="9" y2="4"/>
            <line x1="15" y1="1" x2="15" y2="4"/>
            <line x1="9" y1="20" x2="9" y2="23"/>
            <line x1="15" y1="20" x2="15" y2="23"/>
            <line x1="20" y1="9" x2="23" y2="9"/>
            <line x1="20" y1="14" x2="23" y2="14"/>
            <line x1="1" y1="9" x2="4" y2="9"/>
            <line x1="1" y1="14" x2="4" y2="14"/>
          </svg>
        </div>
        <h3 class="intro-card-title">全平台通用协议兼容</h3>
        <p class="intro-card-desc">
          支持导入 Clash、ClashParty、Shadowrocket 等主流通用工具，覆盖 Windows、macOS、Android 与 iOS 多平台环境，配置灵活透明。
        </p>
        <span class="intro-card-tag">资料核验状态：通用标准支持</span>
      </div>

      <div class="intro-card">
        <div class="intro-icon icon-yellow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="intro-card-title">智能规则模式分流</h3>
        <p class="intro-card-desc">
          支持规则路由分离，国内电商、社交与本地银行流量自动直连，仅境外工作学习流量经由代理中继，在保障网速的同时节省流量。
        </p>
        <span class="intro-card-tag">资料核验状态：客户端分流特性</span>
      </div>
    </div>


  </div>
</section>

<style>
  .section-service-intro {
    background-color: #FFFFFF;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 50px;
  }

  .intro-card {
    background: #F8FAFC;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: 30px 22px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .intro-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .intro-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .icon-purple {
    background: rgba(124, 58, 237, 0.12);
    color: var(--color-aurora-purple);
  }

  .icon-cyan {
    background: rgba(34, 211, 238, 0.15);
    color: #0891B2;
  }

  .icon-blue {
    background: rgba(59, 130, 246, 0.12);
    color: #2563EB;
  }

  .icon-yellow {
    background: rgba(245, 158, 11, 0.12);
    color: #D97706;
  }

  .intro-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--color-midnight);
  }

  .intro-card-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 20px;
    flex: 1;
  }

  .intro-card-tag {
    font-size: 0.75rem;
    color: #64748B;
    background: #EEF2F6;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    display: inline-block;
  }

  .intro-bottom-banner {
    background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 100%);
    border-radius: var(--radius-lg);
    padding: 30px 40px;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .banner-text h4 {
    color: #FFFFFF;
    font-size: 1.25rem;
    margin-bottom: 6px;
  }

  .banner-text p {
    color: #CBD5E1;
    font-size: 0.92rem;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .intro-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .intro-bottom-banner {
      flex-direction: column;
      text-align: left;
      padding: 24px;
    }
    .intro-bottom-banner .btn {
      width: 100%;
    }
  }
</style>
