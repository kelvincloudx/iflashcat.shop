---
import { siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-brand">
        <div class="brand-header">
          <div class="footer-logo-icon">
            <svg width="28" height="28" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="20" cy="20" r="19" fill="#1E293B" stroke="#22D3EE" stroke-width="2"/>
              <path d="M12 15L15 23H25L28 15L23 18H17L12 15Z" fill="#7C3AED"/>
              <path d="M22 10L14 22H21L18 30L27 18H20L22 10Z" fill="#22D3EE"/>
            </svg>
          </div>
          <div class="footer-brand-title">
            <span class="footer-brand-name">闪电猫</span>
            <span class="footer-brand-en">SpeedCAT</span>
          </div>
        </div>
        <p class="footer-desc">
          闪电猫 SpeedCAT 专属品牌落地页。提供公开参考套餐规格、计费周期与价格换算说明，整理主流客户端配置流程与常见网络排查指南。
        </p>
        <div class="footer-aff-action">
          <a 
            href={siteConfig.affUrl} 
            target={siteConfig.affTarget} 
            rel={siteConfig.affRel} 
            class="btn btn-cyan btn-sm"
          >
            {siteConfig.affButtonText}
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-nav">
        <h3 class="footer-heading">站内导航</h3>
        <ul class="footer-links">
          {siteConfig.navItems.map(item => (
            <li>
              <a href={item.href} class="footer-link">{item.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Guide Articles Quick Access -->
      <div class="footer-guides">
        <h3 class="footer-heading">精选教程</h3>
        <ul class="footer-links">
          <li><a href="/guides/speedcat-first-purchase/" class="footer-link">第一次了解与核实</a></li>
          <li><a href="/guides/speedcat-plan-cycles/" class="footer-link">付款周期与价格计算</a></li>
          <li><a href="/guides/speedcat-subscription-management/" class="footer-link">订阅管理与链接保护</a></li>
          <li><a href="/guides/speedcat-traffic-planning/" class="footer-link">流量预算与需求测算</a></li>
          <li><a href="/guides/speedcat-connection-checklist/" class="footer-link">异常连接排查清单</a></li>
        </ul>
      </div>

      </div>
    </div>


    <!-- Bottom Copyright & PBN Friendly Links -->
    <div class="footer-bottom">
      <p class="copyright">
        © 2026 闪电猫 SpeedCAT. 版权所有｜基于独立极光闪电视觉设计
      </p>
      <div class="footer-bottom-links">
        <a href="/pricing/">参考价格表</a>
        <span class="separator">·</span>
        <a href="/faq/">常见问题解答</a>
        <span class="separator">·</span>
        <a href="/guides/">使用配置指南</a>
      </div>
    </div>

    <div class="footer-pbn-links">
      <span class="pbn-label">友情链接：</span>
      <a href="https://jichangreview.net" target="_blank" class="pbn-link">机场测评</a>
      <span class="pbn-divider">|</span>
      <a href="https://jichangguide.net" target="_blank" class="pbn-link">机场教程</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-midnight);
    color: #94A3B8;
    padding: 70px 0 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.4), rgba(124, 58, 237, 0.4), transparent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr 1.4fr;
    gap: 48px;
    margin-bottom: 50px;
  }

  .footer-brand {
    padding-right: 20px;
  }

  .brand-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .footer-brand-title {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .footer-brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: #FFFFFF;
  }

  .footer-brand-en {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-electric-cyan);
    letter-spacing: 0.08em;
  }

  .footer-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #94A3B8;
    margin-bottom: 20px;
  }

  .footer-heading {
    color: #FFFFFF;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 18px;
    position: relative;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    font-size: 0.9rem;
    color: #94A3B8;
    transition: all 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-electric-cyan);
    padding-left: 4px;
  }

  .footer-disclaimer-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    margin-bottom: 40px;
  }

  .disclaimer-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 700;
    color: #FBBF24;
    margin-bottom: 8px;
  }

  .disclaimer-content {
    font-size: 0.88rem;
    line-height: 1.65;
    color: #CBD5E1;
    margin: 0;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.85rem;
  }

  .copyright {
    color: #64748B;
    margin: 0;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-bottom-links a {
    color: #94A3B8;
  }

  .footer-bottom-links a:hover {
    color: var(--color-electric-cyan);
  }

  .separator {
    color: #475569;
  }

  .footer-pbn-links {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px dashed rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.78rem;
    color: #64748B;
  }

  .pbn-label {
    color: #475569;
  }

  .pbn-link {
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pbn-link:hover {
    color: var(--color-electric-cyan);
    text-decoration: underline;
  }

  .pbn-divider {
    color: #334155;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
    .footer-brand {
      grid-column: 1 / -1;
      padding-right: 0;
    }
  }

  @media (max-width: 600px) {
    .site-footer {
      padding: 50px 0 25px;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
