---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonicalPath = '/',
  ogType = 'website',
  jsonLd
} = Astro.props;

// Ensure canonical URL is always strictly https://iflashcat.shop${canonicalPath}
const cleanPath = canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const canonicalUrl = `${siteConfig.url}${cleanPath.endsWith('/') || cleanPath.includes('.') ? cleanPath : `${cleanPath}/`}`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '闪电猫 SpeedCAT',
  alternateName: ['SpeedCAT', '闪电猫'],
  url: `${siteConfig.url}/`,
  description: siteConfig.description,
  inLanguage: 'zh-CN'
};

const schemas = jsonLd ? (Array.isArray(jsonLd) ? [websiteSchema, ...jsonLd] : [websiteSchema, jsonLd]) : [websiteSchema];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="闪电猫, SpeedCAT, 闪电猫订阅, 闪电猫套餐, 闪电猫教程" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={siteConfig.author} />

    <!-- GEO Optimization Meta Tags -->
    <meta name="geo.region" content="HK" />
    <meta name="geo.placename" content="Hong Kong" />
    <meta name="geo.position" content="22.3193;114.1694" />
    <meta name="ICBM" content="22.3193, 114.1694" />

    <!-- Canonical URL strictly set to iflashcat.shop -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="闪电猫 SpeedCAT" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD Structured Data for Search Engines & GEO -->
    {schemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <Header currentPath={canonicalPath} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
